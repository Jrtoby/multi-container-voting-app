# Keeps the whole checkout on one style, whichever editor (or OS) is in use.
# Without this, every editor decides its own line endings and trailing whitespace
# and the diffs fill with noise.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,json,yml,yaml}]
indent_size = 2

# Markdown: trailing spaces are a hard line break, so they are meaningful.
[*.md]
trim_trailing_whitespace = false

# Generated by `flask db migrate`; Alembic rewrites these wholesale.
[app/migrations/**]
trim_trailing_whitespace = false
