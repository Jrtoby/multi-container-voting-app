# Copy this file to .env before running the stack:
#     cp .env.example .env
#
# docker-compose.yml reads these variables for ${...} substitution.
# .env is gitignored, so each teammate sets their own locally.

POSTGRES_USER=voting_user
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=voting_db

# Replace with a long random value before deploying anywhere public.
# Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
