# Copy this file to .env before running the stack:
#     cp .env.example .env
#
# docker-compose.yml reads these variables for ${...} substitution. Every one
# has an inline default in docker-compose.yml, so the stack also boots with no
# .env at all ΓÇö this file exists so you can override them without editing YAML.
#
# .env is gitignored, so each teammate keeps their own copy.

# Consumed by the `db` service to initialise PostgreSQL, and interpolated into
# the DATABASE_URL that `web` and `worker` receive.
POSTGRES_USER=voting_user
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=voting_db

# Signs Flask session cookies. Replace with a long random value before
# deploying anywhere public:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# NOTE: DATABASE_URL is intentionally absent. docker-compose.yml builds it per
# service, because the two consumers need different schemes:
#   web    -> postgresql+psycopg2://...  (SQLAlchemy requires the driver)
#   worker -> postgresql://...           (node-postgres rejects the +psycopg2)
# Setting it here would have no effect, since app.py and worker.js read it from
# the container environment, not from this file.
